<mujoco model="so101_rl_scene">
  <!-- RL scene: upstream SO-101 arm + table, 16 mm die, 60 mm target zone, fiducial.
       Upstream files are NOT modified. Load through so101_rl.sim.load_model(): it compiles this file through
       MjSpec and then adds what plain MJCF cannot express on an included body (primitive jaw collision geoms,
       the gripper_tip site, mesh-jaw collision disable). See assets/so101/README.md. -->
  <include file="upstream/so101_new_calib.xml"/>
  <!-- Later <compiler> wins: upstream's meshdir="assets" is relative to the MAIN file, ours lives one level up. -->
  <compiler angle="radian" meshdir="upstream/assets" autolimits="true"/>
  <!-- D-TIMESTEP (plan §10 2026-10-05): dt = 1/510 s, so MujocoBus.steps_per_tick = round((1/30)/dt) = 17 substeps
       are exactly one 1/30 s servo tick (upstream's default 0.002 s made a tick 34 ms, a 2 % time-scale error).
       Upstream sets no <option>; everything else stays at MuJoCo's defaults (Euler, Newton, pyramidal cone). -->
  <option timestep="0.00196078431372549"/>

  <default>
    <!-- Primitive jaw collision geoms (plan sec. 6: mesh-mesh grasp contact is unstable and slow).
         contype 2 / conaffinity 2: collides with the die and the table, never with the (contype 1) arm meshes.
         margin 0 (was 0.0005): MuJoCo Warp 3.14 raises NotImplementedError for box-box / box-mesh pairs with a
         non-zero margin, and CPU and GPU must run the same model (S0.2, spike 2026-10-05).
         solref 0.004 (= 2 timesteps, the stiffest MuJoCo recommends) / solimp 0.95 0.99 1 mm on the jaw primitives AND the
         die (sim track S1.3, parity Layer C): with MuJoCo's default solref 0.02 the 4 g die's contacts are so soft
         against the 3.35 N m gripper that every scripted grasp crushed through it (gripper closed to its limit, die
         squeezed out upward); with these values the die is held through a 4 cm lift. First guesses until H-series
         grasp data. -->
    <default class="jaw_col">
      <geom type="box" contype="2" conaffinity="2" group="4" rgba="0.9 0.2 0.2 0.3" friction="1.2 0.01 0.001" condim="4" margin="0" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
    <!-- D-TRAY (plan §10 2026-10-05, sim track S1.3): static start-well tray. contype 4 / conaffinity 0 with the die's
         conaffinity bit 4: the tray collides with the DIE ONLY. Not with the jaw primitives (deviation from the plan's
         "die and jaws"): the jaw boxes at the measured rest pose sweep through the tray area in the S0 CPU/Warp
         parity gate (tests/test_warp_model.py sinusoid around rest), and jaw-box vs tray-box contacts diverged
         7e-3 rad between the engines there. Not with the arm meshes (1/1) or the table (static) either.
         priority 1: MuJoCo (and MJWarp) take the tray's friction 0.15 for its contacts instead of the max of the
         pair (the die's 1.0 would not slide down the funnel). Placeholder until H9. -->
    <default class="tray">
      <geom type="box" contype="4" conaffinity="0" priority="1" friction="0.15 0.005 0.0001" condim="3" rgba="0.55 0.6 0.65 1" group="1"/>
    </default>
    <default class="die">
      <geom type="box" size="0.008 0.008 0.008" mass="0.004" contype="2" conaffinity="7" friction="1.0 0.01 0.001" condim="4" rgba="0.8 0.1 0.1 1" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
  </visual>

  <asset>
    <texture type="2d" name="table_tex" builtin="checker" mark="edge" rgb1="0.75 0.75 0.72" rgb2="0.7 0.7 0.67" markrgb="0.4 0.4 0.4" width="300" height="300"/>
    <material name="table_mat" texture="table_tex" texuniform="true" texrepeat="5 5" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Table top at TABLE_Z_M = -0.02 (sim/model.py) -->
    <geom name="table" type="plane" size="0.6 0.6 0.05" pos="0 0 -0.02" material="table_mat" contype="3" conaffinity="3" friction="0.8 0.01 0.001"/>
    <site name="base" pos="0 0 0" size="0.003" group="3"/>
    <!-- Target zone, 60 x 60 mm, flat on the table -->
    <site name="zone" type="box" pos="0.15 -0.13 -0.0195" size="0.03 0.03 0.0005" rgba="0.1 0.7 0.2 0.5" group="1"/>
    <!-- ArUco camera-moved fiducial (H8): DICT_4X4_50 id 0, 50 mm, centre (0.09, 0.05), sides along x / y
         (perception/fiducial.py XY_BASE / SIZE_MM; plan §10 2026-10-17 "H8 software") -->
    <site name="fiducial" type="box" pos="0.09 0.05 -0.0195" size="0.025 0.025 0.0005" rgba="0 0 0 1" group="1"/>
    <!-- No camera here: the D435 cameras d435_color / d435_depth are added by sim/model.py build_spec from
         calib/camera.yaml (the single source of the real camera's intrinsics and pose; sim/d435.py). -->
    <!-- Start-well tray around die_start (0.20, -0.05) (tasks.DIE_TO_ZONE placeholder): a flat 23 x 23 mm well on
         the table, four 50 deg funnel plates out to +-30 mm (22 mm rise; 20 / 35 / 40 deg left dice leaning on the
         slope edge, 45 / 92.5 % returned), and a 26 mm rim. The rim stays 4 mm clear
         of the jaw boxes at the measured rest pose (gripper on the table at y ~ 0). sim/tray_check.py is
         its H9 twin (pixi run tray-check). -->
    <body name="tray" pos="0 0 0">
      <geom name="tray_funnel_xp" class="tray" pos="0.22190 -0.05000 -0.00994" zaxis="-0.76604 0.00000 0.64279" size="0.01439 0.03000 0.00150"/>
      <geom name="tray_funnel_xn" class="tray" pos="0.17810 -0.05000 -0.00994" zaxis="0.76604 0.00000 0.64279" size="0.01439 0.03000 0.00150"/>
      <geom name="tray_funnel_yp" class="tray" pos="0.20000 -0.02810 -0.00994" zaxis="0.00000 -0.76604 0.64279" size="0.03000 0.01439 0.00150"/>
      <geom name="tray_funnel_yn" class="tray" pos="0.20000 -0.07190 -0.00994" zaxis="0.00000 0.76604 0.64279" size="0.03000 0.01439 0.00150"/>
      <geom name="tray_rim_xp" class="tray" pos="0.23150 -0.05000 -0.00700" size="0.00150 0.03300 0.01300"/>
      <geom name="tray_rim_xn" class="tray" pos="0.16850 -0.05000 -0.00700" size="0.00150 0.03300 0.01300"/>
      <geom name="tray_rim_yp" class="tray" pos="0.20000 -0.01850 -0.00700" size="0.03300 0.00150 0.01300"/>
      <geom name="tray_rim_yn" class="tray" pos="0.20000 -0.08150 -0.00700" size="0.03300 0.00150 0.01300"/>
    </body>
    <body name="die" pos="0.20 -0.05 -0.012">
      <freejoint name="die_free"/>
      <geom name="die_geom" class="die"/>
      <site name="die_center" size="0.002" group="3"/>
    </body>
  </worldbody>

  <!-- Placeholders consistent with config/so101.yaml safe_state (home = rest = tick 2047 on every joint = 0 rad on the
       arm joints; gripper 2047 ticks on the 2011..3488 calibration = 2.4 % open). NEEDS H5: replace by the measured
       gravity-stable rest pose; tests/test_sim_model.py checks this stays consistent with the config. -->
  <keyframe>
    <key name="rest" qpos="0.1595 -1.8699 1.5708 1.2379 0.2393 -0.1745  0.20 -0.05 -0.012 1 0 0 0" ctrl="0.1595 -1.8699 1.5708 1.2379 0.2393 -0.1745"/>
    <key name="home" qpos="0 -1.6674 1.0017 1.0753 0 -0.1179  0.20 -0.05 -0.012 1 0 0 0" ctrl="0 -1.6674 1.0017 1.0753 0 -0.1179"/>
  </keyframe>
</mujoco>
